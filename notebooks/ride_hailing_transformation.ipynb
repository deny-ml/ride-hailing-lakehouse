   "source": [
    "# DEPENDENCY DI SERVERLESS\n",
    "%pip install azure-storage-blob\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "from pyspark.sql.functions import col, to_timestamp, when, avg, count, date_trunc\n",
    "from pyspark.sql.types import IntegerType\n",
    "from azure.storage.blob import BlobServiceClient\n",
    "\n",
    "# BYPASS KEAMANAN SERVERLESS: ARAHKAN STAGING KE DALAM /WORKSPACE\n",
    "AZURE_CONN_STR = \"CONNECTION_STRING_AZURE\"\n",
    "\n",
    "WORKSPACE_DIR = os.getcwd() \n",
    "LAKEHOUSE_DIR = os.path.join(WORKSPACE_DIR, \"temp_lakehouse\")\n",
    "\n",
    "blob_service = BlobServiceClient.from_connection_string(AZURE_CONN_STR)\n",
    "\n",
    "def download_to_local(container, prefix, local_dir):\n",
    "    os.makedirs(local_dir, exist_ok=True)\n",
    "    container_client = blob_service.get_container_client(container)\n",
    "    blobs = container_client.list_blobs(name_starts_with=prefix)\n",
    "    for b in blobs:\n",
    "        blob_client = container_client.get_blob_client(b.name)\n",
    "        file_path = os.path.join(local_dir, b.name.split(\"/\")[-1])\n",
    "        with open(file_path, \"wb\") as f:\n",
    "            f.write(blob_client.download_blob().readall())\n",
    "\n",
    "shutil.rmtree(LAKEHOUSE_DIR, ignore_errors=True)\n",
    "bronze_logistics_path = os.path.join(LAKEHOUSE_DIR, \"bronze\", \"logistics\")\n",
    "bronze_weather_path = os.path.join(LAKEHOUSE_DIR, \"bronze\", \"weather\")\n",
    "\n",
    "download_to_local(\"bronze\", \"logistics/\", bronze_logistics_path)\n",
    "download_to_local(\"bronze\", \"weather/\", bronze_weather_path)\n",
    "\n",
    "# TRANSFORMASI MENGGUNAKAN NATIVE PYSPARK\n",
    "df_orders = spark.read.json(f\"file:{bronze_logistics_path}/*.json\")\n",
    "df_weather = spark.read.json(f\"file:{bronze_weather_path}/*.json\")\n",
    "\n",
    "df_orders_clean = df_orders.filter(col(\"status\").isNotNull()) \\\n",
    "    .withColumn(\"timestamp\", to_timestamp(col(\"timestamp\"))) \\\n",
    "    .withColumn(\"delay_minutes\", col(\"delay_minutes\").cast(IntegerType())) \\\n",
    "    .dropDuplicates([\"order_id\"])\n",
    "\n",
    "df_weather_clean = df_weather.select(\n",
    "    col(\"current_weather.temperature\").alias(\"temperature\"),\n",
    "    col(\"current_weather.windspeed\").alias(\"windspeed\"),\n",
    "    to_timestamp(col(\"current_weather.time\")).alias(\"weather_timestamp\")\n",
    ")\n",
    "\n",
    "df_joined = df_orders_clean.crossJoin(df_weather_clean) \\\n",
    "    .withColumn(\"is_delayed\", when(col(\"delay_minutes\") > 0, 1).otherwise(0))\n",
    "\n",
    "df_summary = df_joined \\n",
    "    .withColumn("order_hour", date_trunc("hour", col("timestamp"))) \\n",
    "    .groupBy("order_hour", "status") \\n",
    "    .agg(\n",
    "        count(\"order_id\").alias(\"total_orders\"),\n",
    "        avg(\"delay_minutes\").alias(\"avg_delay_minutes\"),\n",
    "        avg(\"temperature\").alias(\"temperature_celsius\")\n",
    "    )\n",
    "    \n",
    "import pandas as pd\n",
    "\n",
    "# LOAD KE SILVER LAYER (Bypass PlanMetrics Bug)\n",
    "silver_logistics_dir = os.path.join(LAKEHOUSE_DIR, \"silver\", \"logistics\")\n",
    "silver_weather_dir = os.path.join(LAKEHOUSE_DIR, \"silver\", \"weather\")\n",
    "os.makedirs(silver_logistics_dir, exist_ok=True)\n",
    "os.makedirs(silver_weather_dir, exist_ok=True)\n",
    "\n",
    "orders_rows = df_orders_clean.collect()\n",
    "pdf_orders = pd.DataFrame([row.asDict() for row in orders_rows])\n",
    "\n",
    "weather_rows = df_weather_clean.collect()\n",
    "pdf_weather = pd.DataFrame([row.asDict() for row in weather_rows])\n",
    "\n",
    "pdf_orders.to_parquet(os.path.join(silver_logistics_dir, \"orders_clean.parquet\"), index=False)\n",
    "pdf_weather.to_parquet(os.path.join(silver_weather_dir, \"weather_clean.parquet\"), index=False)\n",
    "\n",
    "def upload_files_to_azure(local_dir, container, prefix, file_extension):\n",
    "    container_client = blob_service.get_container_client(container)\n",
    "    for root, dirs, files in os.walk(local_dir):\n",
    "        for file in files:\n",
    "            if file.endswith(file_extension):\n",
    "                local_path = os.path.join(root, file)\n",
    "                blob_client = container_client.get_blob_client(f\"{prefix}{file}\")\n",
    "                with open(local_path, \"rb\") as data:\n",
    "                    blob_client.upload_blob(data, overwrite=True)\n",
    "\n",
    "upload_files_to_azure(silver_logistics_dir, \"silver\", \"logistics/\", \".parquet\")\n",
    "upload_files_to_azure(silver_weather_dir, \"silver\", \"weather/\", \".parquet\")\n",
    "\n",
    "\n",
    "# LOAD KE GOLD LAYER (Bypass PlanMetrics Bug)\n",
    "gold_local_dir = os.path.join(LAKEHOUSE_DIR, \"gold\", \"hourly_summary\")\n",
    "os.makedirs(gold_local_dir, exist_ok=True)\n",
    "gold_local_file = os.path.join(gold_local_dir, \"summary.csv\")\n",
    "\n",
    "summary_rows = df_summary.collect()\n",
    "pdf_summary = pd.DataFrame([row.asDict() for row in summary_rows])\n",
    "pdf_summary.to_csv(gold_local_file, index=False)\n",
    "\n",
    "upload_files_to_azure(gold_local_dir, \"gold\", \"hourly_summary/\", \".csv\")"
   ]
  },
